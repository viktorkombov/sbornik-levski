---
// Видео от YouTube, ако има youtubeId; иначе празна рамка.
interface Props { youtubeId?: string; title: string }
const { youtubeId, title } = Astro.props;
---
<div class="player">
  {youtubeId ? (
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    />
  ) : (
    <>
      <svg role="img" aria-label="Видео" width="64" height="64" viewBox="0 0 64 64" fill="none">
        <circle cx="32" cy="32" r="30" stroke="#C9A24B" stroke-width="2" />
        <path d="M27 21l17 11-17 11z" fill="#C9A24B" />
      </svg>
      <span>[ВИДЕО — добавете youtubeId]</span>
    </>
  )}
</div>
